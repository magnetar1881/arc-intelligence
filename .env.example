# ── Required ──────────────────────────────────────────────
RPC_URL=https://rpc.mainnet.arc.io
GROQ_API_KEY=your_groq_api_key_here

# ── Telegram (optional) ───────────────────────────────────
# Set TELEGRAM_ENABLED=true to activate the bot.
# BOT_TOKEN and CHAT_ID are NOT required when TELEGRAM_ENABLED=false.
TELEGRAM_ENABLED=false
BOT_TOKEN=
CHAT_ID=

# ── Scanner (optional) ────────────────────────────────────
# Set SCANNER_ENABLED=true to start live block scanning.
SCANNER_ENABLED=false

# ── Dashboard ─────────────────────────────────────────────
DASHBOARD_PORT=3000

# ── Whale thresholds (optional, defaults shown) ───────────
WHALE_THRESHOLD=100000
LARGE_TRANSFER_THRESHOLD=250000

# ── Circle App Kit (optional, client-only swap/bridge) ────
# Swap and bridge are signed in the user's MetaMask.
# POST /api/swap/execute and POST /api/bridge/execute return 403.
# Chain string: "Arc"  |  allowanceStrategy: "approve"
CIRCLE_KIT_KEY=

# ── Signals API (optional) ────────────────────────────────
SIGNALS_API_KEY=
SIGNAL_FREE_LIMIT=30
